{
  "name": "neurobase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "refresh": "node --env-file-if-exists=.env scripts/refresh.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "vitest run",
    "validate:funding": "node --env-file-if-exists=.env scripts/validate-funding.js",
    "verify:funding": "node --env-file-if-exists=.env scripts/verify-funding.js",
    "verify:cron": "node --env-file-if-exists=.env scripts/verify-cron.js",
    "images:classes": "node --env-file-if-exists=.env scripts/build-class-images.js",
    "images:backfill": "node --env-file-if-exists=.env scripts/backfill-images.js",
    "verify:images": "node --env-file-if-exists=.env scripts/verify-images.js",
    "images:stories": "node --env-file-if-exists=.env scripts/source-story-images.js",
    "images:bind": "node node_modules/vite-node/vite-node.mjs scripts/bind-home-images.js",
    "images:queue": "node --env-file-if-exists=.env scripts/review-queue.js",
    "verify:frontier": "node --env-file-if-exists=.env scripts/check-frontier-schema.js",
    "digest": "node --env-file-if-exists=.env node_modules/vite-node/vite-node.mjs scripts/send-digest.js",
    "daily": "node --env-file-if-exists=.env scripts/daily.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "jsdom": "^30.0.0",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.0",
    "vitest": "^2.1.9"
  }
}
