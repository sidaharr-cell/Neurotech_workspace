# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Variables prefixed with VITE_ are bundled into the browser build.

# Supabase — from Project Settings → API in the Supabase dashboard
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ─── Scripts (Node.js only — NOT prefixed with VITE_) ───────────────────────
# These are used by refresh.js and seed.js and should NEVER be in the browser.
# Add these as GitHub Actions Secrets and Vercel environment variables.

# Supabase service role key (has write access — keep secret)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# NewsAPI — https://newsapi.org/ (free account, 100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# Free key from https://developer.company-information.service.gov.uk/
# Used by scripts/backfill-companies-house.js for UK incorporation dates.
COMPANIES_HOUSE_KEY=

# ─── Optional: nothing above this line needs these ──────────────────────────
#
# The app runs without any of them, and so does `npm run daily` — each script
# that wants one says so and skips loudly rather than failing the run. They are
# listed because a variable the code reads and the example file omits is found
# one error at a time.

# NCBI E-utilities — https://ncbiinsights.ncbi.nlm.nih.gov/ (free, instant).
# Raises the PubMed rate limit from 3 requests/second to 10, which is the
# difference between hours and minutes on a backfill. Both passes work without
# it, just slower. Used by backfill-pubmed.js and backfill-mesh.js.
NCBI_API_KEY=

# PatentsView — https://search.patentsview.org/ (free, issued by email).
# Used by backfill-patents.js and by the patents step of `npm run daily`.
PATENTSVIEW_API_KEY=

# ─── The emailed "What's new today" digest ──────────────────────────────────
#
# scripts/send-digest.js runs last in scripts/daily.js. Without BOTH of the
# first two it prints a ::warning:: and sends nothing, which is what a repo with
# no mail provider configured should do rather than fail the run. Sending is
# also dry-run by default: `npm run digest` prints the mail, --commit sends it.

# https://resend.com/
RESEND_API_KEY=
# The From: address. Must be on a domain verified with the provider.
DIGEST_FROM=
# Where replies go, since unsubscribing is a reply. Defaults to DIGEST_FROM.
DIGEST_REPLY_TO=
# Absolute origin used to turn the digest's relative links into real ones.
# An email cannot follow a relative href. Defaults to the live site.
SITE_ORIGIN=https://neurobase-live.vercel.app

# ─── One-off backfills and migrations ───────────────────────────────────────

# Lets scripts/run-migration.js apply a file in supabase/migrations/ directly.
# Without it, migrations are run by hand in the Supabase SQL editor, which is
# the documented path. Either the pooler connection string...
DATABASE_URL=
# ...or a personal access token from the Supabase dashboard.
SUPABASE_ACCESS_TOKEN=

# scripts/backfill-patents-bq.js reads the Google Patents public dataset on
# BigQuery. It needs a project id AND an absolute path to a service-account key
# with the "BigQuery Job User" role; the Google SDK reads the second one out of
# the environment on its own. See that script's header for the setup.
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Feature flags ──────────────────────────────────────────────────────────

# Potential-impact sort. STILL OFF: the calibration trial passed on numbers that
# turned out to measure trial design rather than neurotechnology — see
# docs/potential-impact-phase5-result.md before turning it on. Set to 1 to offer
# the sort in a local build.
VITE_FLAG_POTENTIAL_IMPACT=
